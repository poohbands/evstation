generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model OrganizationSettings {
  id                     String   @id @default(cuid())
  companyName            String   @default("")
  address                String   @default("")
  taxId                  String   @default("")
  phone                  String   @default("")
  email                  String   @default("")
  bankName               String   @default("")
  bankAccountNo          String   @default("")
  bankAccountName        String   @default("")
  bankBranch             String?  @default("")
  bankAccountType        String?  @default("SAVINGS")
  contactPerson          String?  @default("")
  contactPhone           String?  @default("")
  signerName             String   @default("")
  signerTitle            String   @default("")
  logoUrl                String   @default("")
  defaultCustomerName    String   @default("")
  defaultCustomerAddress String   @default("")
  defaultCustomerTaxId   String   @default("")
  defaultCustomerBranch  String   @default("")
  isVatRegistered        Boolean  @default(true)
  branchNumber           String   @default("สำนักงานใหญ่")
  isMaintenanceMode      Boolean  @default(false)
  maintenanceMessage     String   @default("ระบบกำลังปิดปรับปรุงชั่วคราวเพื่ออัปเกรดระบบและเพิ่มประสิทธิภาพ กรุณากลับมาใหม่อีกครั้งในภายหลัง")
  maintenanceUntil       String   @default("เร็วๆ นี้")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Document {
  id                  String         @id @default(cuid())
  docNumber           String         @unique
  docType             String         // INV_ELEC, REC_ELEC, INV_RENT, REC_RENT
  refInvoiceId        String?        // reference to parent invoice when this is a receipt
  issueDate           DateTime
  dueDate             DateTime?
  billingMonth        Int
  billingYear         Int
  stationName         String         @default("")
  customerName        String         @default("")
  customerAddress     String         @default("")
  customerTaxId       String         @default("")
  customerBranch      String         @default("")
  contractRef         String         @default("")
  subtotal            Float          @default(0)
  vatRate             Float          @default(7)
  vatAmount           Float          @default(0)
  whtRate             Float          @default(3)
  whtAmount           Float          @default(0)
  grandTotal          Float          @default(0)
  netPayable          Float          @default(0)
  enableVat           Boolean        @default(true)
  enableWht           Boolean        @default(true)
  status              String         @default("PENDING") // PENDING, PAID, CANCELLED
  paymentDate         DateTime?
  paymentMethod       String?        // TRANSFER, CHEQUE, CASH
  paymentRef          String?
  notes               String         @default("")
  thaiBahtText        String         @default("")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  items               DocumentItem[]
  refInvoice          Document?      @relation("InvoiceReceipts", fields: [refInvoiceId], references: [id])
  receipts            Document[]     @relation("InvoiceReceipts")

  // PEA VOLTA fields
  isVatRegistered     Boolean?       @default(true)
  branchNumber        String?        @default("สำนักงานใหญ่")
  totalRawAmount      Float?
  peaFeeAmount        Float?
  totalClaim95        Float?
  payoutStatus        String?        @default("WAITING_SEND")
  payoutType          String?        @default("REGULAR")
  trackingNumber      String?
  shippingDate        DateTime?
  peaReceivedDate     DateTime?
  estimatedPayoutDate DateTime?
}

model DocumentItem {
  id            String   @id @default(cuid())
  documentId    String
  itemOrder     Int
  description   String
  quantity      Float    @default(0)
  unitName      String   @default("")
  unitPrice     Float    @default(0)
  amount        Float    @default(0)
  meterPrevious Float?
  meterCurrent  Float?
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("VIEWER") // ADMIN, ACCOUNTANT, VIEWER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PeaMonthlyFee {
  id           String    @id @default(cuid())
  billingMonth Int
  billingYear  Int
  stationName  String    @default("")
  ref1Contract String    @default("")
  ref2Invoice  String    @default("")
  feeAmount    Float     @default(0)
  vatAmount    Float     @default(0)
  totalAmount  Float     @default(0)
  status       String    @default("PENDING") // PENDING, PAID
  channel      String?   // COUNTER_SERVICE, SMART_PLUS
  paidDate     DateTime?
  receiptImage String?
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
